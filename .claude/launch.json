{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "flask", "--app", "backend/wsgi.py", "run", "--port", "5000"],
      "port": 5000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "frontend-built",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "preview"],
      "port": 4173
    },
    {
      "name": "frontend-phone",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "preview", "--", "--host", "--port", "4174"],
      "env": { "API_PROXY_TARGET": "http://127.0.0.1:5001" },
      "port": 4174
    },
    {
      "name": "app-container",
      "url": "http://localhost:8000",
      "port": 8000
    }
  ]
}
