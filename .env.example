# Copy this file to `.env` and adjust. `.env` is git-ignored; never commit real secrets.

# Flask
# development | testing | production
APP_ENV=development
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Database (matches docker-compose.yml defaults; local-only password)
POSTGRES_PASSWORD=lifeos_dev_only
DATABASE_URL=postgresql+psycopg://lifeos:lifeos_dev_only@127.0.0.1:5432/lifeos
TEST_DATABASE_URL=postgresql+psycopg://lifeos:lifeos_dev_only@127.0.0.1:5432/lifeos_test

# Optional local test account, created by `flask seed-dev-user` (development only)
DEV_USER_EMAIL=dev@lifeos.test
DEV_USER_PASSWORD=change-me-too

